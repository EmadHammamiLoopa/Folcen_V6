# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
node_modules/
/platforms
/plugins
/www

# Local signing/secrets. Keep release keys outside Git; losing this key
# means future APK updates cannot use the same signing identity.
*.jks
*.keystore
*.p12
*.pem
*.key

# Local rollback bundles/snapshots created during dev.
/version-backups

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build
